# Set these only in the backend environment. Never prefix secrets with VITE_.
GEMINI_API_KEY=
COCONUTRAY_GEMINI_ENABLED=false
# Confirm your Google project uses the free tier before enabling.
COCONUTRAY_GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-2.5-flash-lite
COCONUTRAY_GEMINI_RPM=4
COCONUTRAY_GEMINI_RPD=30
COCONUTRAY_DB_PATH=data/network.sqlite3
